{
  "uid": "tenderduty-fibre",
  "title": "Tenderduty · Fibre",
  "description": "Fibre exports and provider checks. Export counters reset when Tenderduty restarts; increase handles those resets. Empty intervals remain gaps.",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "tenderduty",
    "fibre"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "chain",
        "label": "Chain",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(tenderduty_fibre_registered, name)",
        "definition": "label_values(tenderduty_fibre_registered, name)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Uploads",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(tenderduty_fibre_uploads_total{name=~\"$chain\"}[$__rate_interval])",
          "legendFormat": "{{name}} · {{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Data received",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(tenderduty_fibre_upload_bytes_total{name=~\"$chain\"}[$__rate_interval])",
          "legendFormat": "{{name}} · received",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Signing",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * increase(tenderduty_fibre_signatures_fast_total{name=~\"$chain\"}[$__rate_interval]) / ignoring(result) increase(tenderduty_fibre_signatures_total{name=~\"$chain\",result=\"ok\"}[$__rate_interval])",
          "legendFormat": "Fast share %",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "1000 * increase(tenderduty_fibre_sign_seconds_total{name=~\"$chain\"}[$__rate_interval]) / ignoring(result) increase(tenderduty_fibre_signatures_total{name=~\"$chain\",result=\"ok\"}[$__rate_interval])",
          "legendFormat": "Average ms",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "increase(tenderduty_fibre_signatures_total{name=~\"$chain\",result=\"failed\"}[$__rate_interval])",
          "legendFormat": "Failures",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Average ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failures"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.drawStyle",
                "value": "points"
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Storage used vs budget",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tenderduty_fibre_occupancy_bytes{name=~\"$chain\"}",
          "legendFormat": "{{name}} · used",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "tenderduty_fibre_budget_bytes{name=~\"$chain\"} > 0",
          "legendFormat": "{{name}} · budget",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(tenderduty_fibre_store_errors_total{name=~\"$chain\"}[$__rate_interval])",
          "legendFormat": "{{name}} · {{op}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "increase(tenderduty_fibre_storage_backend_requests_total{name=~\"$chain\",outcome=~\"timeout|throttled|error\"}[$__rate_interval])",
          "legendFormat": "{{name}} · {{backend}} · {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Downloads served",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(tenderduty_fibre_download_bytes_total{name=~\"$chain\"}[$__rate_interval])",
          "legendFormat": "Served bytes",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "increase(tenderduty_fibre_downloads_total{name=~\"$chain\",result=\"ok\"}[$__rate_interval])",
          "legendFormat": "OK",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "increase(tenderduty_fibre_downloads_total{name=~\"$chain\",result=\"failed\"}[$__rate_interval])",
          "legendFormat": "Failed",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "OK|Failed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Reachability",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tenderduty_fibre_reachable{name=~\"$chain\"}",
          "legendFormat": "{{name}} · reachable",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unreachable",
                  "color": "red"
                },
                "1": {
                  "text": "Reachable",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.8
      }
    },
    {
      "id": 8,
      "title": "Provider and identity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tenderduty_fibre_registered{name=~\"$chain\"}",
          "legendFormat": "{{name}} · registered",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "tenderduty_fibre_identity_verified{name=~\"$chain\"}",
          "legendFormat": "{{name}} · verified",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "tenderduty_fibre_row_share{name=~\"$chain\"}",
          "legendFormat": "{{name}} · row share",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (name, le) (rate(tenderduty_fibre_upload_seconds_bucket{name=~\"$chain\"}[5m])))",
          "legendFormat": "{{name}} upload p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (name, le) (rate(tenderduty_fibre_upload_seconds_bucket{name=~\"$chain\"}[5m])))",
          "legendFormat": "{{name}} upload p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.5, sum by (name, le) (rate(tenderduty_fibre_download_seconds_bucket{name=~\"$chain\"}[5m])))",
          "legendFormat": "{{name}} download p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (name, le) (rate(tenderduty_fibre_download_seconds_bucket{name=~\"$chain\"}[5m])))",
          "legendFormat": "{{name}} download p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.5, sum by (name, le) (rate(tenderduty_fibre_sign_seconds_bucket{name=~\"$chain\"}[5m])))",
          "legendFormat": "{{name}} sign p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "F",
          "expr": "histogram_quantile(0.95, sum by (name, le) (rate(tenderduty_fibre_sign_seconds_bucket{name=~\"$chain\"}[5m])))",
          "legendFormat": "{{name}} sign p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "G",
          "expr": "histogram_quantile(0.5, sum by (name, le) (rate(tenderduty_fibre_store_put_seconds_bucket{name=~\"$chain\"}[5m])))",
          "legendFormat": "{{name}} store_put p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "H",
          "expr": "histogram_quantile(0.95, sum by (name, le) (rate(tenderduty_fibre_store_put_seconds_bucket{name=~\"$chain\"}[5m])))",
          "legendFormat": "{{name}} store_put p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "I",
          "expr": "histogram_quantile(0.5, sum by (name, le) (rate(tenderduty_fibre_store_get_seconds_bucket{name=~\"$chain\"}[5m])))",
          "legendFormat": "{{name}} store_get p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "J",
          "expr": "histogram_quantile(0.95, sum by (name, le) (rate(tenderduty_fibre_store_get_seconds_bucket{name=~\"$chain\"}[5m])))",
          "legendFormat": "{{name}} store_get p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "K",
          "expr": "histogram_quantile(0.5, sum by (name, le) (rate(tenderduty_fibre_prune_seconds_bucket{name=~\"$chain\"}[5m])))",
          "legendFormat": "{{name}} prune p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "L",
          "expr": "histogram_quantile(0.95, sum by (name, le) (rate(tenderduty_fibre_prune_seconds_bucket{name=~\"$chain\"}[5m])))",
          "legendFormat": "{{name}} prune p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Fibre process",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tenderduty_fibre_go_memory_used_bytes{name=~\"$chain\"}",
          "legendFormat": "{{name}} Memory used",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "tenderduty_fibre_go_gc_goal_bytes{name=~\"$chain\"}",
          "legendFormat": "{{name}} GC goal",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "tenderduty_fibre_go_goroutines{name=~\"$chain\"}",
          "legendFormat": "{{name}} Goroutines",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "D",
          "expr": "rate(tenderduty_fibre_go_memory_allocated_bytes_total{name=~\"$chain\"}[5m])",
          "legendFormat": "{{name}} Allocation rate",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.95, sum by (name, le) (rate(tenderduty_fibre_go_schedule_seconds_bucket{name=~\"$chain\"}[5m])))",
          "legendFormat": "{{name}} Schedule p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Goroutines$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Allocation rate$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Schedule p95$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
